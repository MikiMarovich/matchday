# Copiá este archivo como .env.local y completá los valores.
# Las variables NEXT_PUBLIC_ llegan al navegador: nunca pongas claves secretas ahí.

# Supabase → Connect (o Project Settings → API Keys)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Email (en minúsculas) del administrador. Solo servidor. Debe coincidir con public.admins.
ADMIN_EMAIL=

# URL pública de la app (http://localhost:3000 en desarrollo)
NEXT_PUBLIC_SITE_URL=

# Solo para scripts/test-concurrency.mjs (Session pooler). Nunca en Vercel.
DATABASE_URL=

# Más adelante (Paso 8):
# RESEND_API_KEY=
# RESEND_FROM=
