# Copiá este archivo como .env.local y completá los valores.
# Las variables NEXT_PUBLIC_ llegan al navegador: nunca pongas claves secretas ahí.

# Supabase → Connect (o Project Settings → API Keys)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Email(s) de los administradores, separados por coma. Solo servidor. Deben coincidir con public.admins.
# Ej.: ADMIN_EMAIL=uno@gmail.com,otro@gmail.com
ADMIN_EMAIL=

# URL pública de la app (http://localhost:3000 en desarrollo)
NEXT_PUBLIC_SITE_URL=

# Solo para scripts/test-concurrency.mjs (Session pooler). Nunca en Vercel.
DATABASE_URL=

# Email al admin cuando llega un comprobante (Gmail SMTP). Solo servidor: NUNCA con NEXT_PUBLIC_.
# GMAIL_APP_PASSWORD es una "contraseña de aplicación" de Google (16 letras), no la clave de Gmail.
GMAIL_USER=
GMAIL_APP_PASSWORD=
